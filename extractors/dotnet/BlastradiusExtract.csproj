<Project Sdk="Microsoft.NET.Sdk">

  <!-- Blastradius C# L4 extractor (spec/l4-introspection.md): Roslyn
       syntax-level, no MSBuildWorkspace — works on any checkout without a
       restore/build of the target solution. net8.0 + RollForward so any
       newer installed runtime executes it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <!-- The fixture corpus is data for the test script, never compiled. -->
  <ItemGroup>
    <Compile Remove="fixtures/**" />
  </ItemGroup>

</Project>
