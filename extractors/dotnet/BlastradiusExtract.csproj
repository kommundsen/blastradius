<Project Sdk="Microsoft.NET.Sdk">

  <!-- Blastradius C# L4 extractor (spec/l4-introspection.md): Roslyn
       syntax-level, no MSBuildWorkspace — works on any checkout without a
       restore/build of the target solution. net8.0 + RollForward so any
       newer installed runtime executes it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Roslyn ships localized resources for fourteen languages. The
         extractor's only output is JSON on stdout and English diagnostics on
         stderr, and a release stages this published (tools/stage-extractors.mjs),
         so they are pure package weight. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <!-- Opt-in semantic mode only (spec/l4-introspection.md): MSBuild lives
         here, never in core (ADR-0016). ExcludeAssets=runtime on the locator's
         MSBuild deps is required — the located SDK supplies them at runtime. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.11.0" />
    <!-- The C# language services: without them MSBuildWorkspace loads the
         solution but refuses every project with "language 'C#' is not
         supported". -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
  </ItemGroup>

  <!-- The fixture corpus is data for the test script, never compiled. -->
  <ItemGroup>
    <Compile Remove="fixtures/**" />
  </ItemGroup>

</Project>
