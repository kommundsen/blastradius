{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/diagram/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system token via var(). Sizes: --text-2xs..--text-3xl. Space: --space-1..--space-8. Controls: --control-h/--control-px/--row-py."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow|Barlow Condensed))/i]",
        "message": "Font not provided by the design system. Available: Barlow, Barlow Condensed."
      },
      {
        "selector": "Literal[value=/border-radius\\s*:\\s*(?!0)/]",
        "message": "Square corners are the brand. Use var(--radius), which is 0."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:block|children|className|disabled|icon|key|onClick|ref|style|variant)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, icon, block, disabled, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|style)$/]",
        "message": "<ButtonGroup> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Canvas'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|overlay|ref|scale|style|theme|x|y)$/]",
        "message": "<Canvas> doesn't accept that prop. Declared props: theme, scale, x, y, overlay, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:blueprint|children|className|key|kicker|meta|ref|style|title)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: kicker, title, meta, blueprint, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagramNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|children|className|external|key|kicker|meta|onSelect|ref|status|style|title|type|width|x|y)$/]",
        "message": "<DiagramNode> doesn't accept that prop. Declared props: kicker, title, meta, type, status, external, active, x, y, width, style, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:actions|children|className|key|onDismiss|ref|style|title)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: title, actions, onDismiss, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Edge'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|children|className|direction|from|key|label|labelOffset|onSelect|ref|routing|secondary|status|style|to|waypoints)$/]",
        "message": "<Edge> doesn't accept that prop. Declared props: from, to, waypoints, routing, direction, secondary, active, status, label, labelOffset, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='EdgeLayer'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|style)$/]",
        "message": "<EdgeLayer> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|error|id|key|label|multiline|onChange|placeholder|ref|style|value)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, multiline, error, id, placeholder, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segmented'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|label|name|onChange|options|ref|style|value)$/]",
        "message": "<Segmented> doesn't accept that prop. Declared props: options, value, onChange, name, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|style|variant)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Canvas'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Canvas> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagramNode'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:added|removed|changed|conflict|invalid)$/]",
        "message": "<DiagramNode> status must be one of 'added' | 'removed' | 'changed' | 'conflict' | 'invalid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagramNode'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:person|system|container|component)$/]",
        "message": "<DiagramNode> type must be one of 'person' | 'system' | 'container' | 'component'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Edge'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:forward|both|none)$/]",
        "message": "<Edge> direction must be one of 'forward' | 'both' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Edge'] > JSXAttribute[name.name='routing'] > Literal[value!=/^(?:straight|orthogonal)$/]",
        "message": "<Edge> routing must be one of 'straight' | 'orthogonal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Edge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:added|removed)$/]",
        "message": "<Edge> status must be one of 'added' | 'removed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:accent|neutral|outline|danger|warning|success)$/]",
        "message": "<Tag> variant must be one of 'accent' | 'neutral' | 'outline' | 'danger' | 'warning' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Edge']:not(:has(JSXAttribute[name.name='from']))",
        "message": "<Edge> needs `from` and `to` points. The x/length/angle form was removed — edges are SVG paths now."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
